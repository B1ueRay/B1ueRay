DATABASE_URL=postgresql://velora:velora_local_only@localhost:5432/velora
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
MEDIA_SIGNING_SECRET=replace-with-another-32-character-secret
PAYMENT_WEBHOOK_SECRET=replace-with-another-32-character-secret
DEMO_MODE=true
BLOCKED_COUNTRIES=
TRUST_COUNTRY_HEADER=false
REDIS_URL=redis://localhost:6379
STORAGE_PATH=.storage

# Optional social provider; register /api/auth/callback/google at the provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional LLM via FreeLLMAPI (https://github.com/tashfeenahmed/freellmapi), or any
# OpenAI-compatible /v1 endpoint. Empty values keep the built-in mock replies.
# With `docker compose --profile llm up`, use http://freellmapi:3001/v1 and take the
# unified API key from the FreeLLMAPI dashboard (http://localhost:3001, Keys page).
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
FREELLMAPI_TIMEOUT_MS=25000
FREELLMAPI_MAX_TOKENS=400
# Required only for the `llm` compose profile: 64 hex chars (openssl rand -hex 32).
FREELLMAPI_ENCRYPTION_KEY=
